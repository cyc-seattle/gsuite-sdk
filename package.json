{
  "name": "@cyc-seattle/gsuite-sdk",
  "version": "0.0.0-development",
  "description": "Domain-agnostic wrappers around Google Workspace APIs",
  "author": "CYC Community Sailing Center",
  "license": "Apache-2.0",
  "homepage": "https://github.com/cyc-seattle/gsuite-sdk#readme",
  "bugs": {
    "url": "https://github.com/cyc-seattle/gsuite-sdk/issues"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cyc-seattle/gsuite-sdk.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.34.7",
  "prettier": "@cyc-seattle/ts-config/prettier",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./fake": {
      "types": "./dist/fake/index.d.ts",
      "default": "./dist/fake/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/fake/main.*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "exponential-backoff": "^3.1.3",
    "google-spreadsheet": "^5.0.0",
    "googleapis": "^144.0.0",
    "luxon": "^3.7.2",
    "winston": "^3.18.3"
  },
  "devDependencies": {
    "@amiceli/vitest-cucumber": "^8.0.0",
    "@cyc-seattle/ts-config": "^0.1.2",
    "@types/luxon": "^3.7.1",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4"
  }
}
